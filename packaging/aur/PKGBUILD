# Maintainer: AugustLigh <https://github.com/AugustLigh>
pkgname=llauncher
pkgver=0.3.0
pkgrel=1
pkgdesc="Native Linux launcher for Arknights: Endfield"
arch=('x86_64')
url="https://github.com/AugustLigh/LLauncher"
license=('MIT')
depends=('webkit2gtk-4.1' 'gtk3' 'glib2' 'libsoup3' 'openssl' 'glib-networking' 'libayatana-appindicator' 'hicolor-icon-theme')
makedepends=('cargo' 'yarn' 'nodejs' 'base-devel')
optdepends=(
  'gamemode: CPU governor optimizations while gaming'
  'mangohud: FPS / frametime overlay'
  'gamescope: micro-compositor with FSR upscaling, FPS cap and HDR'
)
provides=('llauncher')
conflicts=('llauncher-bin' 'llauncher-git')
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/refs/tags/${pkgver}.tar.gz")
sha256sums=('SKIP') # Update this with the real hash after releasing

prepare() {
    cd "LLauncher-${pkgver}"
    
    # Download dependencies
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
    yarn install
}

build() {
    cd "LLauncher-${pkgver}"
    
    export RUSTUP_TOOLCHAIN=stable
    # Build only the binary without bundling .deb or AppImage
    yarn tauri build -b none
}

package() {
    cd "LLauncher-${pkgver}"
    
    # Install binary
    install -Dm755 "src-tauri/target/release/llauncher" "${pkgdir}/usr/bin/llauncher"
    
    # Install desktop file
    install -Dm644 "src-tauri/llauncher.desktop" "${pkgdir}/usr/share/applications/llauncher.desktop"
    
    # Install icons
    install -Dm644 "src-tauri/icons/32x32.png" "${pkgdir}/usr/share/icons/hicolor/32x32/apps/llauncher.png"
    install -Dm644 "src-tauri/icons/64x64.png" "${pkgdir}/usr/share/icons/hicolor/64x64/apps/llauncher.png"
    install -Dm644 "src-tauri/icons/128x128.png" "${pkgdir}/usr/share/icons/hicolor/128x128/apps/llauncher.png"
    install -Dm644 "src-tauri/icons/128x128@2x.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/llauncher.png"
    install -Dm644 "src-tauri/icons/icon.png" "${pkgdir}/usr/share/icons/hicolor/512x512/apps/llauncher.png"
}
